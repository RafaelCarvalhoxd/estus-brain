PORT=8080
DATABASE_URL=postgres://estus:estus@localhost:5432/estus_vault?sslmode=disable

# Senha de login do app. Revelar uma senha do cofre pede ela de novo. Vazia,
# ninguém entra. O frontend precisa do mesmo valor: scripts/estus-brain.sh
# repassa este; com `npm run dev`, repita em frontend/.env.local.
APP_PASSWORD=

# Vault de senhas — sem isto o módulo fica desativado (o resto do app
# continua funcionando normalmente).
# Gere com: openssl rand -base64 32
VAULT_ENCRYPTION_KEY=

# Agenda / Google Calendar — sem isto a Agenda funciona só localmente,
# sem sincronizar. Veja o README para o passo a passo no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/google/oauth/callback
FRONTEND_URL=http://localhost:3000

# Documentos — onde os arquivos enviados são gravados. O caminho é relativo
# ao diretório de onde o binário roda (em desenvolvimento, backend/), então
# por padrão o acervo fica dentro do próprio projeto, fora do git.
DOCUMENTS_DIR=data/documents

# Assistente (chat, MCP e motores de IA)
# Token que apps de IA externos usam no /mcp. Vazio = gerado uma vez e salvo
# em ASSISTANT_DIR/mcp-token (aparece em Conversa > Motor de IA e conexões).
MCP_TOKEN=
ASSISTANT_DIR=data/assistant
# Fuso do dono: "hoje", "mês que vem" e horários são lidos nele.
ASSISTANT_TZ=America/Sao_Paulo
# Agente externo do chat (Hermes, OpenClaw…). A tela de ajustes do chat
# tem prioridade; estes valores cobrem o que ficar vazio lá.
# Hermes: http://127.0.0.1:8642 com o API_SERVER_KEY dele como token.
AGENT_URL=
AGENT_TOKEN=
AGENT_MODEL=
# Só para gerar imagem (generate_image/edit_image). Sem ela, usa o Draw Things local.
OPENAI_API_KEY=
